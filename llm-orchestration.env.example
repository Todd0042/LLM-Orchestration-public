# LLM-Orchestration: settings for this machine.
# Copy to llm-orchestration.env (git-ignored) next to this file and edit. Plain KEY=value lines.
# The daemon reads it on start; values already in the environment (e.g. from systemd) win.
# They seed settings.json the first time the daemon runs; after that, change settings in the app
# (Settings) or with scripts/configure_node.py. Secrets never go here: the node token and the
# authenticator secret are created on first start and live in ~/.config and ~/.local/share.

# --- This machine -----------------------------------------------------------------------------
# Short id and role. One machine is the hub (the orchestrator you talk to); others are workers.
# Leave unset to detect them (a machine with a battery is "laptop", otherwise "desktop").
#LLM_ORCH_NODE_ID=desktop
#LLM_ORCH_ROLE=hub
#LLM_ORCH_PORT=8790
# Workers only: the hub's address.
#LLM_ORCH_HUB_URL=http://192.0.2.10:8790

# Folder with your git repositories (default: ~/GitHub, else ~/Documents/GitHub).
#LLM_ORCH_GITHUB_DIR=~/GitHub

# --- Remote access ----------------------------------------------------------------------------
# Host names your tunnel or reverse proxy serves the UI on (comma-separated). Empty = LAN/local only.
#LLM_ORCH_PUBLIC_HOSTS=orchestrator.example.com
# Where the authenticator (TOTP) secret is kept. Default: ~/.local/share/llm-orchestration
#LLM_ORCH_TOTP_DIR=~/.local/share/llm-orchestration

# --- Agents -----------------------------------------------------------------------------------
# Let AGY / Claude Code run without asking for permission (--dangerously-skip-permissions).
# Off by default; you can also switch it per engine in Settings.
#LLM_ORCH_AGENT_SKIP_PERMISSIONS=0

# --- Models -----------------------------------------------------------------------------------
# OpenAI-compatible model server (llama.cpp server, Ollama /v1, LM Studio, ...).
#LLM_ORCH_LLM_BASE=http://127.0.0.1:8080/v1
# Optional folders listed as capabilities when the model server is down.
#LLM_ORCH_LLM_MODELS_DIR=~/models/llm
#LLM_ORCH_COMFY_MODELS_DIR=~/ComfyUI/models
#LLM_ORCH_COMFY_LAUNCHER=~/bin/comfy
#LLM_ORCH_COMFY_URL=http://127.0.0.1:8188
# Optional GPU turn-taking service; set to 0 if you don't run one.
LLM_ORCH_USE_GPU_SCHEDULER=0
#LLM_ORCH_GPU_SCHEDULER_URL=http://127.0.0.1:11436

# --- Sites, alerts, backups, failover (two machines) ------------------------------------------
# Phone alerts via ntfy (https://ntfy.sh): your topic URL. Treat it like a password.
#LLM_ORCH_NTFY_URL=https://ntfy.sh/your-secret-topic
# Database backups shipped to the other machine land here (on the receiving machine).
#LLM_ORCH_BACKUPS_DIR=~/Backups/llm-orchestration
# Standby machine: the systemd unit that starts your stand-in tunnel connectors, and a URL that
# only answers while the primary machine serves your public address.
#LLM_ORCH_FAILOVER_UNIT=llm-orchestration-failover.target
#LLM_ORCH_PUBLIC_PROBE_URL=https://orchestrator.example.com/api/health
